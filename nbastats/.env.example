DB_URL=jdbc:postgresql://localhost:5432/nba
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_WRITE_ENABLED=true

# Credentials for POST, PUT and DELETE. Without a password the write endpoints
# exist but cannot be authenticated against.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
