# Base URL of the Spring Boot stats API (no trailing slash).
#
# Local development points at the API running on your machine. The deployed
# frontend sets this to the public backend origin
# (https://nba-stats-api-4jl6.onrender.com) as a Vercel environment variable,
# and that origin must in turn appear in the backend's CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
